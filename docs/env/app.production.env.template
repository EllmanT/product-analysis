# StockFlow app: Vercel > Settings > Environment Variables > Production.
# Blank on purpose. Fill in the host dashboard, never commit real values.
# NEXT_PUBLIC_* are baked in at build time: redeploy after changing them.
# NODE_ENV=production is set by Vercel; do not add it. Do NOT set OFFLINE_MONGODB_URI or any TEST_* variable.
# See docs/PRODUCTION_CHECKLIST.md section 3 for what each one does.

# ── Database ─────────────────────────────────────────────
MONGODB_URI=
MONGO_DB_NAME=

# ── Auth ─────────────────────────────────────────────────
# openssl rand -base64 32
AUTH_SECRET=
# Production Clerk instance (pk_live_ / sk_live_)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Comma-separated emails. If BOOTSTRAP is empty, every admin is a super admin.
BOOTSTRAP_ADMIN_EMAILS=
STAFF_ALLOWED_EMAILS=
# Only if Google / GitHub sign-in is offered (production OAuth apps)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# ── Public URLs (all the app's own address, https://app.<domain>) ──
NEXT_PUBLIC_SITE_URL=
SITE_URL=
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_API_BASE_URL=

# ── Scheduler ────────────────────────────────────────────
# openssl rand -hex 32. Vercel sends it to the cron routes automatically.
CRON_SECRET=

# ── Fiscal ───────────────────────────────────────────────
FISCAL_BACKEND=service
FISCAL_SERVICE_URL=
# Must equal the service's FISCAL_SERVICE_TOKEN
FISCAL_SERVICE_TOKEN=
# openssl rand -base64 32. DIFFERENT from the service's key. Back it up separately.
FISCAL_ENCRYPTION_KEY=
# Optional fallback; the central device is chosen in the app (Fiscal devices > Make central)
FISCAL_SERVICE_CENTRAL_DEVICE_ID=
# Leave blank for the ZIMRA test gateway. Keep "use production URL" OFF in fiscal settings.
ZIMRA_API_URL=
POS_TIMEZONE=Africa/Harare
FISCAL_ALERT_EMAILS=

# ── Email (use SMTP_* only, not EMAIL_*) ─────────────────
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ADMIN_EMAIL=

# ── Company and invoice defaults ─────────────────────────
INVOICE_COMPANY_LEGAL_NAME=
INVOICE_COMPANY_TRADE_NAME=
INVOICE_COMPANY_TIN=
INVOICE_COMPANY_VAT_NUMBER=
INVOICE_COMPANY_ADDRESS=
INVOICE_COMPANY_PHONE=
INVOICE_COMPANY_EMAIL=
INVOICE_COMPANY_REGION=
INVOICE_COMPANY_CITY=
INVOICE_DEFAULT_TAX_CODE=
INVOICE_DEFAULT_TAX_PERCENT=
INVOICE_DEFAULT_CURRENCY=
INVOICE_DEFAULT_RECEIPT_PRINT_FORM=
# 8 digits
INVOICE_DEFAULT_HS_CODE=

# ── Optional: leave out to keep the feature off ──────────
# Shop checkout stays OFF unless this is exactly "true"
# NEXT_PUBLIC_SHOP_CHECKOUT_ENABLED=
# Despatch-slip scanning
# ANTHROPIC_API_KEY=
# DESPATCH_SCAN_MODEL=
# Shop document matching
# OPENAI_API_KEY=
# OPENAI_DOCUMENT_MODEL=
# Background upload queue (rediss:// URL)
# BULLMQ_REDIS_URL=
# LOG_LEVEL=info
# Online payments (only with checkout enabled)
# ECOCASH_API_URL=
# ECOCASH_USERNAME=
# ECOCASH_PASSWORD=
# ECOCASH_MERCHANT_CODE=
# ECOCASH_MERCHANT_PIN=
# ECOCASH_TERMINAL_ID=
# ECOCASH_MERCHANT_NAME=
# ECOCASH_SUPER_MERCHANT=
# ECOCASH_LOCATION=
# ECOCASH_CURRENCY=
# ECOCASH_NOTIFY_URL=
# ZIMSWITCH_BASE_URL=
# ZIMSWITCH_AUTHORIZATION_TOKEN=
# ZIMSWITCH_TEST_MODE=
# ZIMSWITCH_PAYMENT_TYPE=
# ZIMSWITCH_ENTITY_VISA_MASTER_USD=
# ZIMSWITCH_ENTITY_ZIMSWITCH_USD=
