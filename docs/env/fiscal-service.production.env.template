# Fiscal service: Railway / Render / Fly.io / VPS environment variables.
# Blank on purpose. Fill in the host dashboard, never commit real values.
# Run exactly ONE instance. Health check: GET /health. See docs/PRODUCTION_CHECKLIST.md sections 4 and 5.

# The service's OWN database (not the app's)
FISCAL_MONGODB_URI=
FISCAL_MONGODB_DB=fiscal_service

# openssl rand -hex 32 (16+ characters required). Must equal the app's FISCAL_SERVICE_TOKEN.
FISCAL_SERVICE_TOKEN=

# openssl rand -base64 32. Encrypts stored device certificates and keys.
# DIFFERENT from the app's key. Back it up separately from the database.
FISCAL_ENCRYPTION_KEY=

# Only when rotating the key
# FISCAL_ENCRYPTION_KEY_ID=

# Most hosts inject PORT themselves; default is 4100
# PORT=4100
